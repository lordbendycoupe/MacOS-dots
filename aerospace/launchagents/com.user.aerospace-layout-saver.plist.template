<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.user.aerospace-layout-saver</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.config/aerospace/scripts/save-layout.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>10</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/aerospace-layout-saver.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/aerospace-layout-saver.log</string>
</dict>
</plist>
